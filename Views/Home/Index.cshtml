@{
    ViewData["Title"] = "Chat";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2>SignalR Chat</h2>
    <p class="text-muted">Open this page in two tabs to see real-time messaging.</p>

    <div class="mb-3">
        <input id="userInput" class="form-control" placeholder="Your name" value="" />
    </div>

    <div id="messages"
         class="border rounded p-3 mb-3 bg-light"
         style="height: 320px; overflow-y: auto;">
    </div>

    <div class="input-group">
        <input id="messageInput" class="form-control" placeholder="Type a message and press Enter..." />
        <button id="sendButton" class="btn btn-primary">Send</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js"></script>
}