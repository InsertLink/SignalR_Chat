@{
    ViewData["Title"] = "Chat";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2>SignalR Chat</h2>

    <div id="joinPanel" class="card card-body mb-3">
        <p class="text-muted mb-2">Choose a username and a room.</p>
        <div class="mb-2">
            <input id="userInput" class="form-control" placeholder="Your username" maxlength="30" />
        </div>
        <div class="mb-2">
            <select id="roomInput" class="form-select">
                <option value="primary">Primary</option>
                <option value="secondary">Secondary</option>
                <option value="announcements">Announcements</option>
            </select>
        </div>
        <button id="joinButton" class="btn btn-primary">Join chat</button>
        <div id="joinError" class="text-danger small mt-2"></div>
    </div>

    <div id="chatPanel" class="d-none">
        <p class="text-muted">
            Chatting as <strong id="currentUserLabel"></strong>
            in <strong id="currentRoomLabel"></strong>
        </p>

        <div class="input-group mb-2">
            <select id="roomSwitchInput" class="form-select">
                <option value="primary">Primary</option>
                <option value="secondary">Secondary</option>
                <option value="announcements">Announcements</option>
            </select>
            <button id="switchRoomButton" class="btn btn-outline-secondary">Switch</button>
        </div>

        <div id="messages"
             class="border rounded p-3 mb-3 bg-light"
             style="height: 320px; overflow-y: auto;">
        </div>

        <div class="input-group">
            <input id="messageInput" class="form-control" placeholder="Type a message and press Enter..." />
            <button id="sendButton" class="btn btn-primary">Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js"></script>
}